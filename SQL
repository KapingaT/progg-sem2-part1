create database PROG_Assignment


CREATE TABLE Account(
    accountID INT PRIMARY KEY NOT NULL,
    account_name VARCHAR(50),
);
--User--
CREATE TABLE Users (
    usersID INT PRIMARY KEY NOT NULL,
    Email VARCHAR(50) UNIQUE,
    userName VARCHAR(50),
    accountID INT,
    FOREIGN KEY (accountID) REFERENCES Account(accountID)
);

CREATE TABLE Organiser(
    organiserID INT PRIMARY KEY,
    organiserNumber INT,
    usersID INT,
    FOREIGN KEY (usersID) REFERENCES Users(usersID)
);

CREATE TABLE Participant(
    participantID INT PRIMARY KEY NOT NULL,
    participantName VARCHAR(50),
    usersID INT,
    FOREIGN KEY(usersID) REFERENCES Users(usersID)
);

CREATE TABLE Events(
    eventID INT PRIMARY KEY NOT NULL,
    eventName VARCHAR(50),
    eventDescription VARCHAR(50),
    organiserID INT,
    participantID INT,
    FOREIGN KEY(organiserID) REFERENCES Organiser(organiserID),
    FOREIGN KEY(participantID) REFERENCES Participant(participantID)
);

CREATE TABLE Categories(
    categoriesID INT PRIMARY KEY NOT NULL,
    categoriesName VARCHAR(50),
    organiserID INT,
    participantID INT,
    FOREIGN KEY(participantID) REFERENCES Participant(participantID),
    FOREIGN KEY(organiserID) REFERENCES Organiser(organiserID)
);

CREATE TABLE Result(
    resultID INT PRIMARY KEY NOT NULL,
    resultpercentage VARCHAR(50),
    participantID INT,
    FOREIGN KEY(participantID) REFERENCES Participant(participantID)
);

